# Server-only Home Assistant bridge settings. Never prefix these with NEXT_PUBLIC_.
HA_BASE_URL=
HA_ACCESS_TOKEN=

# Optional exact entity override. The safe default is climate.dover_house.
HA_CLIMATE_ENTITY_ID=climate.dover_house

# Production uses Vercel OIDC and Google Workload Identity Federation by default.
# These non-secret values match the commissioned Dover Controls trust resources.
GCP_PROJECT_NUMBER=812439006468
GCP_SERVICE_ACCOUNT_EMAIL=dover-controls-web-admin@dovercontrols.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-dovercontrols
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Optional legacy/local fallback only. Vercel deployments always use WIF instead.
# Never expose this value to browser code.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# The sole bootstrap owner. This account must already exist in Firebase Authentication.
DOVER_BOOTSTRAP_OWNER_EMAIL=kkratoville@gmail.com

# Optional migration fallback for pre-role accounts. New accounts use Firebase custom claims.
DOVER_ALLOWED_FIREBASE_EMAILS=
