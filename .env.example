# Server-only Home Assistant bridge settings. Never prefix these with NEXT_PUBLIC_.
HA_BASE_URL=
HA_ACCESS_TOKEN=

# Optional exact entity override. The safe default is climate.dover_house.
HA_CLIMATE_ENTITY_ID=climate.dover_house

# Required comma-separated Firebase login emails allowed to control the bridge.
DOVER_ALLOWED_FIREBASE_EMAILS=operator@example.com
